main/mark/1.0/"}},"united-states":{"name":"United States","revision":2,"image":{"path":"profiles/images/united-states-r1.png","alt":"United States flag with thirteen red and white stripes and fifty white stars on a blue canton.","sourceUrl":"https://commons.wikimedia.org/wiki/File:Flag_of_the_United_States.svg","creator":"Dbenbenn and Wikimedia Commons contributors, including Zscout370, Jacobolus, Indolences, Technion, TheTaraStark and Jarekt","license":"Public domain (PD-USGov and PD-shape)","licenseUrl":"https://creativecommons.org/publicdomain/mark/1.0/"}},"vietnam":{"name":"Vietnam","revision":1,"image":{"path":"profiles/images/vietnam-r1.png","alt":"Flag of Vietnam with a yellow five-pointed star centered on red","sourceUrl":"https://commons.wikimedia.org/wiki/File:Flag_of_Vietnam.svg","creator":"Government of Vietnam; Wikimedia Commons contributors (file history)","license":"Public domain (common-property flag geometry)","licenseUrl":"https://commons.wikimedia.org/wiki/File:Flag_of_Vietnam.svg#Licensing"}}};
 const results=[];
 for(const viewport of [{width:1440,height:1000},{width:390,height:844}]){
  await page.setViewportSize(viewport);
  for(const link of links){
   await page.goto('http://127.0.0.1:4186/'+link.href);
   await page.getByRole('heading',{level:1,name:link.name,exact:true}).waitFor();
   await page.locator('main article').last().waitFor();
   const axes=await page.locator('main article').count();
   const image=await page.locator('main img').evaluate(async img=>{await img.decode();return {src:img.getAttribute('src'),loaded:img.complete&&img.naturalWidth>0,width:img.naturalWidth}});
   const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth);
   await page.getByText('Sources and assessment',{exact:true}).click();
   const downloadLink=await page.getByRole('link',{name:'Download the full assessment'}).getAttribute('href');
   const response=await page.request.get(new URL(downloadLink,page.url()).href);const audit=await response.json();
   const ex=expected[audit.id];if(!ex||audit.revision!==ex.revision||axes!==15||overflow||!image.loaded||response.status()!==200||audit.axes.flatMap(a=>a.answers).length!==240||audit.axes.flatMap(a=>a.answers).some(a=>a.value===null||a.basis==='unknown'))throw Error('Country check failed: '+link.name);
   results.push({country:link.name,viewport,axes,image,overflow,downloadStatus:response.status(),revision:audit.revision,id:audit.id,answerCount:audit.axes.flatMap(a=>a.answers).filter(a=>a.value!==null).length});
  }
 }
 await page.getByRole('link',{name:'Image credits',exact:true}).click();
 const credits=[];for(const link of links){const section=page.locator('section').filter({has:page.getByRole('heading',{name:link.name+' flag',exact:true})}).first();credits.push({country:link.name,found:await section.count(),source:await section.getByRole('link',{name:'Wikimedia Commons source',exact:true}).getAttribute('href'),license:await section.getByRole('link',{name:'Licence or public-domain status',exact:true}).getAttribute('href')})}
 for(const c of credits){const ex=Object.values(expected).find(e=>e.name===c.country);if(c.source!==ex.image.sourceUrl||c.license!==ex.image.licenseUrl||c.found!==1)throw Error('Credit check failed: '+c.country);}
 return {results,credits};
})(page);
