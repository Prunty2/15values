":"Public domain (PD-self release on Commons)","licenseUrl":"https://commons.wikimedia.org/wiki/File:Flag_of_Malaysia.svg#Licensing"}},{"id":"ethiopia","name":"Ethiopia","image":{"path":"profiles/images/ethiopia-r1.png","alt":"Flag of Ethiopia: Green, yellow and red bands with the blue disc and gold emblem.","sourceUrl":"https://commons.wikimedia.org/wiki/File:Flag_of_Ethiopia.svg","creator":"SKopp; Wikimedia Commons contributors","license":"Public domain (official symbols exempt in Ethiopia)","licenseUrl":"https://commons.wikimedia.org/wiki/File:Flag_of_Ethiopia.svg#Licensing"}}]){
  const heading=page.getByRole('heading',{name:item.name+' flag',exact:true});
  if(await heading.count()!==1)throw Error('Missing or duplicate credit '+item.id);
  const section=heading.locator('..');
  const source=section.getByRole('link',{name:'Wikimedia Commons source',exact:true});
  const licence=section.getByRole('link',{name:'Licence or public-domain status',exact:true});
  if(await source.getAttribute('href')!==item.image.sourceUrl)throw Error(item.id+' source link mismatch');
  if(await licence.getAttribute('href')!==item.image.licenseUrl)throw Error(item.id+' licence link mismatch');
  const text=await section.innerText();
  if(!text.includes(item.image.creator)||!text.includes(item.image.license)||!text.includes('no cropping or recolouring'))throw Error(item.id+' credit text mismatch');
  await heading.scrollIntoViewIfNeeded();records.push({id:item.id,mode,title:true,creator:true,licence:true,sourceLink:await source.getAttribute('href'),licenceLink:await licence.getAttribute('href'),modifications:true});
 }
}
return records;
})(page);
