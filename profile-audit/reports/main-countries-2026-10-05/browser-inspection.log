### Ran Playwright code
```js
await (async (page) => {
 const records=[];
 for(const [mode,width,height] of [['desktop',1440,1000],['mobile',390,844]]) {
  await page.setViewportSize({width,height});
  for(const item of [{"id":"india","name":"India","alt":"Flag of India: Saffron, white and green horizontal bands with a navy Ashoka Chakra."},{"id":"italy","name":"Italy","alt":"Flag of Italy: Green, white and red vertical bands."},{"id":"spain","name":"Spain","alt":"Flag of Spain: Red, yellow and red horizontal bands with the Spanish coat of arms."},{"id":"ukraine","name":"Ukraine","alt":"Flag of Ukraine: Blue and yellow horizontal bands."},{"id":"egypt","name":"Egypt","alt":"Flag of Egypt: Red, white and black bands with the gold Eagle of Saladin."},{"id":"bangladesh","name":"Bangladesh","alt":"Flag of Bangladesh: A red disc on a green field."},{"id":"philippines","name":"Philippines","alt":"Flag of Philippines: Blue and red bands with a white triangle, gold sun and three stars."},{"id":"thailand","name":"Thailand","alt":"Flag of Thailand: Red, white, wide blue, white and red horizontal bands."},{"id":"malaysia","name":"Malaysia","alt":"Flag of Malaysia: Red and white stripes with a blue canton, gold crescent and star."},{"id":"ethiopia","name":"Ethiopia","alt":"Flag of Ethiopia: Green, yellow and red bands with the blue disc and gold emblem."}]) {
   await page.goto('http://127.0.0.1:4185/#/countries');
   const search=page.getByRole('searchbox',{name:'Search countries'});
   await search.waitFor({state:'visible'});await search.fill(item.name);
   const card=page.getByRole('link',{name:item.name,exact:true});
   await card.waitFor({state:'visible'});await search.focus();await page.keyboard.press('Tab');
   const keyboardFocus=await card.evaluate(el=>el===document.activeElement);
   if(!keyboardFocus)throw Error(item.id+' search-to-card keyboard focus');
   await page.keyboard.press('Enter');
   await page.getByRole('heading',{name:item.name,exact:true,level:1}).waitFor({state:'visible'});
   const rows=page.getByRole('article');const count=await rows.count();if(count!==15)throw Error(item.id+' axis rows '+count);
   const rowNames=await rows.evaluateAll(els=>els.map(el=>el.getAttribute('aria-label')));
   const image=page.getByRole('img',{name:item.alt,exact:true});
   await image.waitFor({state:'visible'});
   await image.evaluate(el=>el.decode());
   const flag=await image.evaluate(el=>({loaded:el.complete&&el.naturalWidth>0,width:el.naturalWidth,height:el.naturalHeight,source:el.getAttribute('src')}));
   if(!flag.loaded)throw Error(item.id+' unloaded flag');
   const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>window.innerWidth+1);
   if(overflow)throw Error(item.id+' '+mode+' horizontal overflow');
   const link=page.getByRole('link',{name:'Download the full assessment',exact:true});
   const href=await link.getAttribute('href');
   const downloadWait=page.waitForEvent('download');await link.click();const download=await downloadWait;
   await download.saveAs("/Users/liam/Documents/GitHub/15values/output/playwright/main10/"+item.id+'-'+mode+'.json');
   if(await download.failure())throw Error(item.id+' download failed');
   if(['india','spain','thailand'].includes(item.id))await page.screenshot({path:"/Users/liam/Documents/GitHub/15values/output/playwright/main10/"+item.id+'-'+mode+'.png',fullPage:true});
   records.push({id:item.id,mode,width,search:true,keyboard:true,detail:true,axisRows:count,rowNames,flag,overflow,download:download.suggestedFilename(),href});
  }
 }
 await page.getByRole('link',{name:'Image credits',exact:true}).click();
 console.log(JSON.stringify(records));
})(page);
```
