const results=[];const errors=[];page.on('pageerror',e=>errors.push(e.message));
for(const width of [1440,390]) {
 await page.setViewportSize({width,height:width===390?844:1000});
 for(const p of profiles) {
  const route=p.catalogue==='personality'?'personalities':'ideologies';
  await page.goto('http://127.0.0.1:4190/political-quiz/#/'+route);
  const search=page.getByRole('searchbox');await search.waitFor();await search.fill(p.name);
  const link=p.catalogue==='personality'?page.getByRole('link',{name:p.name,exact:true}):page.getByRole('link',{name:'View '+p.name+' profile',exact:true});
  await link.waitFor();await link.click();await page.getByRole('heading',{level:1,name:p.name,exact:true}).waitFor();
  const count=await page.locator('main article').count();if(count!==15)throw Error(p.id+' axes '+count);
  if(p.image){const im=page.getByRole('img',{name:p.image.alt,exact:true}).first();await im.waitFor();await im.evaluate(el=>el.decode());if(!await im.evaluate(el=>el.naturalWidth>0))throw Error(p.id+' image');}
  if(!await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth))throw Error(p.id+' horizontal overflow at '+width);
  await page.locator('summary').filter({hasText:'Sources and assessment'}).first().click();
  const dl=page.getByRole('link',{name:'Download the full assessment',exact:true});
  const href=await dl.getAttribute('href');if(!href.endsWith(p.auditPath))throw Error(p.id+' download href');
  const promise=page.waitForEvent('download');await dl.click();const download=await promise;
  if(await download.failure())throw Error(p.id+' download failure');await download.saveAs('output/playwright/second-profile-verification/'+p.id+'-'+width+'.json');
  if(['robert-mugabe','giorgia-meloni','thomas-rousseau'].includes(p.id))await page.screenshot({path:'output/playwright/'+p.id+'-'+width+'.png',fullPage:true});
  results.push({id:p.id,width,index:true,search:true,detail:true,axes:count,portrait:p.image?'decoded':'not required',download:download.suggestedFilename(),horizontalOverflow:false});
 }
 await page.getByRole('link',{name:'Image credits',exact:true}).click();await page.getByRole('heading',{level:1,name:'Image credits.',exact:true}).waitFor();
 for(const p of profiles.filter(p=>p.image)){const section=page.locator('main section').filter({has:page.locator('a[href='+JSON.stringify(p.image.sourceUrl)+']')});if(await section.count()!==1)throw Error(p.id+' shared credit');if(await section.locator('a').filter({hasText:/source/i}).getAttribute('href')!==p.image.sourceUrl)throw Error(p.id+' credit source');if(await section.locator('a[href='+JSON.stringify(p.image.licenseUrl)+']').first().getAttribute('href')!==p.image.licenseUrl)throw Error(p.id+' credit license');}
}
if(errors.length)throw Error(JSON.stringify(errors));return {results,creditsChecked:profiles.filter(p=>p.image).length*2,pageErrors:errors};
})(page);
